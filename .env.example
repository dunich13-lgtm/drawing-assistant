# Copy this file to .env and fill in real values. .env is gitignored.
# FREE TIER ONLY — no billing on either account.

# Main: Google Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Everyday / bulk work: 15 per minute, 500 per day (free tier)
GEMINI_MODEL=gemini-3.5-flash-lite
# Smart model for important checks (JEV judge): 5 per minute, 20 per day each - use sparingly
GEMINI_SMART_MODEL=gemini-3.8-flash
# Tried in order when the smart model is busy (HTTP 503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Backup: OpenRouter free models only (key from https://openrouter.ai/keys, starts with sk-or-)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto-free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
